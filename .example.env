# Copy to .env.local and fill in. NONE of these are exposed to the browser.

# Supabase project (Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password to open the app (the shared gate)
APP_PASSWORD=change-me-to-something-long

# Secret used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-with-32+-random-bytes-hex

# Only needed to RUN the importer (scripts/import_xlsx.py).
# Supabase -> Settings -> Database -> Connection string (URI). Use the pooler URI.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
